---
import GlobalSearchModal from './GlobalSearchModal.jsx';

const { activeTab = '' } = Astro.props;
---

<header>
    <div class="container">
        <a href="/" class="logo">
            <img src="/assets/images/logo.png" alt="RSMK Logo" />RSMK<span>.</span>
        </a>
        
        <nav class="nav-links">
            <a href="/" class={activeTab === 'home' ? 'active' : ''}>Home</a>
            <a href="/blogs" class={activeTab === 'articles' ? 'active' : ''}>Articles</a>
            <a href="/topics" class={activeTab === 'topics' ? 'active' : ''}>Topics</a>
            <a href="/about" class={activeTab === 'about' ? 'active' : ''}>About</a>
        </nav>

        <div style="display: flex; align-items: center; gap: 12px;">
            <GlobalSearchModal client:load />
            <button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle Dark Mode">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </div>
    </div>
</header>
